---
import SectionTitle from "../components/SectionTitle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const channels = [
  {
    title: "Workshop registration",
    description:
      "Interested in an upcoming workshop? Reach out for pricing, availability, and registration details.",
    href: `mailto:${site.email}?subject=Workshop%20Registration%20Inquiry`,
    label: "Email about workshops",
  },
  {
    title: "Guest teaching",
    description:
      "Invite Ivano to lead a guest workshop, intensive, or residency at your studio, school, or festival.",
    href: `mailto:${site.email}?subject=Guest%20Teaching%20Inquiry`,
    label: "Inquire about guest teaching",
  },
  {
    title: "Scholarships",
    description:
      "Scholarships are available for practitioners of color, trans theatre-makers, and those from underrepresented backgrounds.",
    href: `mailto:${site.email}?subject=Scholarship%20Inquiry`,
    label: "Ask about scholarships",
  },
  {
    title: "General inquiries",
    description:
      "Questions about the work, the pedagogy, or anything else? Andrea and Ivano are happy to help.",
    href: `mailto:${site.email}`,
    label: site.email,
  },
];
---

<BaseLayout
  title="Contact"
  description={`Contact ${site.name} for workshop registration, guest teaching, scholarships, and general inquiries.`}
>
  <section class="page-hero section">
    <div class="page-hero__inner reveal">
      <p class="eyebrow">Contact</p>
      <h1>Join the next workshop, or bring the work to your studio.</h1>
      <p>
        Whether you want to register for an upcoming intensive, invite Ivano
        to teach at your school or festival, or simply ask a question --
        reach out. Andrea and Ivano are here to help.
      </p>
    </div>
    <aside class="page-hero__aside reveal">
      <div class="detail-card">
        <h2>Common reasons to reach out</h2>
        <ul class="check-list">
          <li>Register for a Commedia dell'Arte or Neutral Mask workshop</li>
          <li>Ask about pricing, early bird rates, or bundle discounts</li>
          <li>Inquire about guest teaching or festival residencies</li>
          <li>Apply for a scholarship</li>
        </ul>
      </div>
    </aside>
  </section>

  <section class="section">
    <SectionTitle
      eyebrow="Get In Touch"
      title="Warm regards from Rome."
      description="The fastest way to start is a simple email. We respond to every message."
    />
    <div class="contact-grid">
      {
        channels.map((channel) => (
          <article class="contact-card reveal">
            <h2>{channel.title}</h2>
            <p>{channel.description}</p>
            <a class="button button--ghost" href={channel.href}>{channel.label}</a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
