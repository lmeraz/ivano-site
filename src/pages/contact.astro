---
import SectionTitle from "../components/SectionTitle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { reader } from "../lib/reader";

const [siteSettings, contact] = await Promise.all([
  reader.singletons.siteSettings.read(),
  reader.singletons.contact.read(),
]);
if (!siteSettings) throw new Error("Site settings not found");
if (!contact) throw new Error("Contact content not found");
const channels = contact.channels.map((ch) => ({
  ...ch,
  href: ch.subject
    ? `mailto:${siteSettings.email}?subject=${encodeURIComponent(ch.subject)}`
    : `mailto:${siteSettings.email}`,
  label: ch.label || siteSettings.email,
}));
---

<BaseLayout
  title="Contact"
  description={`Contact ${siteSettings.name} for workshop registration, guest teaching, scholarships, and general inquiries.`}
>
  <section class="page-hero section">
    <div class="page-hero__inner reveal">
      <p class="eyebrow">Contact</p>
      <h1>{contact.heroHeadline}</h1>
      <p>{contact.heroDescription}</p>
    </div>
    <aside class="page-hero__aside reveal">
      <div class="portrait-card">
        <img
          src="/hero-contact.jpg"
          alt="Ivano Conte in conversation -- seated in the studio"
          class="portrait-card__img"
          width="600"
          height="450"
          loading="eager"
        />
      </div>
      <div class="detail-card">
        <h2>Common reasons to reach out</h2>
        <ul class="check-list">
          <li>Register for a Commedia dell'Arte or Neutral Mask workshop</li>
          <li>Ask about pricing, early bird rates, or bundle discounts</li>
          <li>Inquire about guest teaching or festival residencies</li>
          <li>Apply for a scholarship</li>
        </ul>
      </div>
    </aside>
  </section>

  <section class="section">
    <SectionTitle
      eyebrow="Get In Touch"
      title="Warm regards from Rome."
      description="The fastest way to start is a simple email. We respond to every message."
    />
    <div class="contact-grid">
      {
        channels.map((channel) => (
          <article class="contact-card reveal">
            <h2>{channel.title}</h2>
            <p>{channel.description}</p>
            <a class="button button--ghost" href={channel.href}>{channel.label}</a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
