---
import PastWorkshopList from "../components/PastWorkshopList.astro";
import PillarGrid from "../components/PillarGrid.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TestimonialGrid from "../components/TestimonialGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { reader, personSchema } from "../lib/reader";

const siteSettings = await reader.singletons.siteSettings.read();
if (!siteSettings) throw new Error("Site settings not found");

const about = await reader.singletons.about.read();
if (!about) throw new Error("About content not found");

const home = await reader.singletons.home.read();
if (!home) throw new Error("Home content not found");

const testimonialsData = await reader.singletons.testimonials.read();
if (!testimonialsData) throw new Error("Testimonials not found");

const allPastWorkshops = await reader.collections.pastWorkshops.all();
const pastWorkshops = allPastWorkshops.map((w) => w.entry);
---

<BaseLayout
  title="About"
  description={`${siteSettings.name} is a theatre pedagogue and movement teacher trained in the Lecoq pedagogy, specializing in Commedia dell'Arte, Neutral Mask, and physical theatre.`}
  structuredData={await personSchema("/about/")}
>
  <section class="page-hero section">
    <div class="page-hero__inner reveal">
      <p class="eyebrow">About {siteSettings.name}</p>
      <h1>{about.heroHeadline}</h1>
      <p>{about.heroDescription}</p>
    </div>
    <aside class="page-hero__aside reveal">
      <div class="portrait-card">
        <img
          src="/portrait.jpg"
          alt="Ivano Conte -- theatre pedagogue and movement teacher"
          class="portrait-card__img"
          width="320"
          height="320"
          loading="eager"
        />
      </div>
    </aside>
  </section>

  <section class="section">
    <div class="split-layout">
      <div>
        <SectionTitle
          eyebrow="Biography"
          title="Trained by masters, committed to the tradition."
        />
      </div>
      <div class="story-stack">
        {about.bioParagraphs.map((para) => (
          <article class="info-card reveal">
            <p>{para}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <SectionTitle
      eyebrow="Philosophy"
      title="Mistakes are where discovery begins."
      description="A teaching approach built on play within the group and a space open to experimentation."
    />
    <PillarGrid pillars={[...home.pillars]} />
  </section>

  <section class="section">
    <div class="image-band">
      <img src="/teaching.jpg" alt="Ivano leading a workshop -- students in movement on the floor" class="image-band__img reveal" width="1080" height="763" loading="lazy" />
      <img src="/workshop-group.jpg" alt="Workshop ensemble with Commedia dell'Arte masks" class="image-band__img reveal" width="1080" height="1080" loading="lazy" />
      <img src="/neutral-mask.jpg" alt="The Neutral Mask -- foundational tool of the Lecoq pedagogy" class="image-band__img reveal" width="1080" height="1350" loading="lazy" />
    </div>
  </section>

  <section class="section">
    <div class="split-layout">
      <div>
        <SectionTitle
          eyebrow="Teaching Story"
          title="In his own words."
        />
      </div>
      <div class="story-stack">
        {about.teachingQuotes.map((quote) => (
          <article class="info-card reveal">
            <p>"{quote}"</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <SectionTitle
      eyebrow="Ideal Student"
      title="Someone willing to step up and put themselves on the line."
      description="Not just professionals -- anyone drawn to physical expression, presence, and play."
    />
    <PillarGrid pillars={[...about.idealStudents]} />
  </section>

  <section class="section">
    <SectionTitle
      eyebrow="Workshop History"
      title="International teaching across three continents."
    />
    <PastWorkshopList workshops={pastWorkshops} />
  </section>

  <section class="section section--tint">
    <SectionTitle
      eyebrow="What Students Say"
      title="Words from those who have done the work."
    />
    <TestimonialGrid testimonials={testimonialsData.items.slice(0, 3)} />
  </section>
</BaseLayout>
