---
import GalleryGrid from "../components/GalleryGrid.astro";
import PhilosophyGrid from "../components/PhilosophyGrid.astro";
import PillarGrid from "../components/PillarGrid.astro";
import SectionTitle from "../components/SectionTitle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { reader, personSchema } from "../lib/reader";

const [siteSettings, about] =
  await Promise.all([
    reader.singletons.siteSettings.read(),
    reader.singletons.about.read(),
  ]);
if (!siteSettings) throw new Error("Site settings not found");
if (!about) throw new Error("About content not found");
---

<BaseLayout
  title="About"
  description={`${siteSettings.name} is a theatre pedagogue and movement teacher trained in the Lecoq pedagogy, specializing in Commedia dell'Arte, Neutral Mask, and physical theatre.`}
  structuredData={personSchema(siteSettings, "/about/")}
>
  <section class="page-hero section">
    <div class="page-hero__inner reveal">
      <p class="eyebrow">Movement, Theatre & Creative Inquiry</p>
      <h1>{about.heroHeadline}</h1>
      <p>{about.heroDescription}</p>
    </div>
    <aside class="page-hero__aside reveal">
      <div class="portrait-card">
        <img
          src="/portrait.jpg"
          alt="Ivano Conte -- theatre pedagogue and movement teacher"
          class="portrait-card__img"
          width="600"
          height="600"
          loading="eager"
        />
      </div>
    </aside>
  </section>

  <section class="section">
    <div class="split-layout">
      <SectionTitle
        eyebrow="Biography"
        title="Background and training."
      />
      <div class="story-stack">
        {about.bioParagraphs.map((para: string) => (
          <article class="info-card reveal">
            <p>{para}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <SectionTitle
      eyebrow="Teaching Philosophy"
      title="Movement as Inquiry, Creation as Practice"
      description="I see the actor not as a container to fill, but as an artist with a physical intelligence already present in their body: an intelligence that can be sharpened, questioned, and expanded."
    />
    <PhilosophyGrid areas={about.philosophyAreas} />
  </section>

  <section class="section">
    <div class="split-layout">
      <SectionTitle
        eyebrow="Teaching Story"
        title="Teaching philosophy."
      />
      <div class="story-stack">
        {about.teachingQuotes.map((quote: string) => (
          <article class="info-card reveal">
            <p>{quote}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <SectionTitle
      eyebrow="Ideal Student"
      title="Someone willing to step up and put themselves on the line."
    />
    <PillarGrid pillars={about.idealStudents} />
  </section>

  <section class="section">
    <SectionTitle
      eyebrow="In The Studio & On Stage"
      title="Gallery"
    />
    <GalleryGrid images={about.galleryImages} />
  </section>

</BaseLayout>
