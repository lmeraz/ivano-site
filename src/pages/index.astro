---
import PillarGrid from "../components/PillarGrid.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TestimonialGrid from "../components/TestimonialGrid.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { reader, personSchema } from "../lib/reader";

const [siteSettings, home, testimonialsData, allWorkshops] =
  await Promise.all([
    reader.singletons.siteSettings.read(),
    reader.singletons.home.read(),
    reader.singletons.testimonials.read(),
    reader.collections.workshops.all(),
  ]);
if (!siteSettings) throw new Error("Site settings not found");
if (!home) throw new Error("Home content not found");
if (!testimonialsData) throw new Error("Testimonials not found");
const featuredWorkshops = allWorkshops
  .map((w: { slug: string; entry: Record<string, any> }) => ({ ...w.entry, slug: w.slug }))
  .filter((w: Record<string, any>) => w.featured);
---

<BaseLayout
  title="Commedia dell'Arte, Neutral Mask & Physical Theatre Workshops"
  description={siteSettings.description}
  structuredData={personSchema(siteSettings)}
>
  <section class="hero section">
    <div class="hero__copy reveal">
      <p class="eyebrow">Movement Teacher &middot; Physical Theatre &middot; Lecoq Pedagogy</p>
      <h1>Movement. Presence. Imagination.</h1>
      <p class="hero__lede">
        I am a movement teacher and physical theatre practitioner with an
        international background rooted in Jacques Lecoq's pedagogy. I combine
        movement training, mask work (neutral, larval, expressive, half-mask),
        Commedia dell'Arte, mimodynamics, clown, bouffon, and the Feldenkrais
        Method® to help performers develop awareness, precision, and a more
        articulate physical language.
      </p>
      <div class="button-row">
        <a class="button" href="/workshops/">View upcoming workshops</a>
        <a class="button button--ghost" href="/about/">About my approach</a>
      </div>
    </div>

    <aside class="hero__panel reveal">
      <div class="portrait-card">
        <img
          src="/hero.jpg"
          alt="Ivano Conte -- movement teacher and physical theatre practitioner"
          class="portrait-card__img"
          width="1080"
          height="1350"
          loading="eager"
        />
      </div>
    </aside>
  </section>

  <section class="section">
    <SectionTitle
      eyebrow="Approach"
      title="Movement as inquiry, creation as practice."
      description="My workshops do not teach imitation or a fixed style: they help performers discover their own physical imagination and the unique way their bodies can think, communicate, and invent on stage."
    />
    <PillarGrid pillars={home.pillars} />
  </section>

  <section class="section section--tint" id="featured-workshops">
    <SectionTitle
      eyebrow="Next Workshops"
      title="Upcoming workshops."
    />
    <div class="card-grid">
      {featuredWorkshops.map((workshop: any) => <WorkshopCard workshop={workshop} />)}
    </div>
  </section>

  <section class="section section--tint">
    <SectionTitle
      eyebrow="Testimonials"
      title="What students say."
    />
    <TestimonialGrid testimonials={testimonialsData.items.slice(0, 3)} />
  </section>

  <section class="section">
    <div class="banner reveal">
      <div class="banner__copy">
        <p class="eyebrow">Contact</p>
        <h2>Warm regards from Rome.</h2>
      </div>
      <div class="banner__actions">
        <a class="button" href="/contact/">Get in touch</a>
        <a class="button button--soft" href="/about/">About my approach</a>
      </div>
    </div>
  </section>

</BaseLayout>
