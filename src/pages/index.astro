---
import PillarGrid from "../components/PillarGrid.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TestimonialGrid from "../components/TestimonialGrid.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { reader, personSchema } from "../lib/reader";

const siteSettings = await reader.singletons.siteSettings.read();
if (!siteSettings) throw new Error("Site settings not found");

const home = await reader.singletons.home.read();
if (!home) throw new Error("Home content not found");

const testimonialsData = await reader.singletons.testimonials.read();
if (!testimonialsData) throw new Error("Testimonials not found");

const faqsData = await reader.singletons.faqs.read();
if (!faqsData) throw new Error("FAQs not found");

const allWorkshops = await reader.collections.workshops.all();
const featuredWorkshops = allWorkshops
  .map((w) => w.entry)
  .filter((w) => w.featured);
---

<BaseLayout
  title="Commedia dell'Arte, Neutral Mask & Physical Theatre Workshops"
  description={siteSettings.description}
  structuredData={await personSchema()}
>
  <section class="hero section">
    <div class="hero__copy reveal">
      <p class="eyebrow">Commedia dell'Arte &middot; Neutral Mask &middot; Physical Theatre</p>
      <h1>The mask is a piece of leather. <em>You</em> are the instrument.</h1>
      <p class="hero__lede">
        {siteSettings.name} leads international workshops in Commedia dell'Arte,
        Neutral Mask, and physical theatre rooted in the Lecoq pedagogy.
        A space for play, experimentation, and the freedom to discover.
      </p>
      <div class="button-row">
        <a class="button" href="/workshops/">View upcoming workshops</a>
        <a class="button button--ghost" href="/about/">Teaching philosophy</a>
      </div>
      <div class="hero__stats">
        {
          home.stats.map((stat) => (
            <article class="stat-card">
              <span class="stat-card__value">{stat.value}</span>
              <span class="stat-card__label">{stat.label}</span>
            </article>
          ))
        }
      </div>
    </div>

    <aside class="hero__panel reveal">
      <div class="portrait-card">
        <img
          src="/commedia-mask.jpg"
          alt="Commedia dell'Arte character in mask -- workshop performance"
          class="portrait-card__img"
          width="1080"
          height="1350"
          loading="eager"
        />
      </div>
      <div class="spotlight-card">
        <p class="eyebrow">What the work holds</p>
        <ul class="spotlight-list">
          <li>Commedia dell'Arte intensives with masked character work</li>
          <li>Neutral Mask workshops for presence and physical clarity</li>
          <li>International residencies and guest studio intensives</li>
        </ul>
      </div>
    </aside>
  </section>

  <section class="section">
    <SectionTitle
      eyebrow="Approach"
      title="Play freely. Work rigorously. Carry it forward."
      description="The teaching philosophy is rooted in play, experimentation, and the belief that mistakes are not to be demonized -- they are where discovery begins."
    />
    <PillarGrid pillars={[...home.pillars]} />
  </section>

  <section class="section section--tint" id="featured-workshops">
    <SectionTitle
      eyebrow="Next Workshops"
      title="Upcoming intensives in Los Angeles."
      description="Five days of Commedia dell'Arte followed by a Neutral Mask weekend. Take one or immerse yourself in both."
    />
    <div class="card-grid">
      {featuredWorkshops.map((workshop) => <WorkshopCard workshop={workshop} />)}
    </div>
  </section>

  <section class="section">
    <div class="split-layout">
      <div>
        <SectionTitle
          eyebrow="In The Room"
          title="Every session begins in the body."
          description="The structure moves from physical preparation through ensemble play to integration -- rigorous training that stays playful."
        />
      </div>
      <ol class="process-list">
        {
          home.process.map((step, index) => (
            <li class="process-step reveal">
              <span class="process-step__number">0{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tint">
    <SectionTitle
      eyebrow="Testimonials"
      title="What performers say after the work."
    />
    <TestimonialGrid testimonials={testimonialsData.items.slice(0, 3)} />
  </section>

  <section class="section">
    <div class="banner reveal">
      <div class="banner__copy">
        <p class="eyebrow">Stay connected</p>
        <h2>New dates, early access, and workshop updates from Rome and beyond.</h2>
        <p>
          Reach out to be first to know when new workshops open for registration
          in Los Angeles, Europe, and beyond.
        </p>
      </div>
      <div class="banner__actions">
        <a class="button" href="/contact/">Get in touch</a>
        <a class="button button--soft" href="/about/">Read the teaching story</a>
      </div>
    </div>
  </section>

  <section class="section section--narrow" id="faq">
    <SectionTitle
      eyebrow="FAQ"
      title="Questions that come up before joining."
      description="For performers, educators, and anyone curious about the work."
      align="center"
    />
    <div class="faq-list">
      {
        faqsData.items.map((item) => (
          <details class="faq-item reveal">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
