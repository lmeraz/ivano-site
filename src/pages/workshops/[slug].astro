---
import SectionTitle from "../../components/SectionTitle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { reader } from "../../lib/reader";

export async function getStaticPaths() {
  const allWorkshops = await reader.collections.workshops.all();
  return allWorkshops
    .filter((w: { entry: Record<string, any> }) => (import.meta.env.PROD ? !w.entry.archived : true))
    .map((workshop: { slug: string; entry: Record<string, any> }) => ({
      params: { slug: workshop.slug },
      props: { workshop: { ...workshop.entry, slug: workshop.slug } },
    }));
}

const { workshop } = Astro.props;

const siteSettings = await reader.singletons.siteSettings.read();
if (!siteSettings) throw new Error("Site settings not found");

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: workshop.title,
  description: workshop.summary,
  startDate: workshop.startDate,
  endDate: workshop.endDate,
  eventAttendanceMode:
    workshop.format === "In-person"
      ? "https://schema.org/OfflineEventAttendanceMode"
      : "https://schema.org/MixedEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: workshop.venue,
    address: workshop.location,
  },
  organizer: {
    "@type": "Person",
    name: siteSettings.name,
    email: siteSettings.email,
    url: siteSettings.siteUrl,
  },
  url: `${siteSettings.siteUrl}/workshops/${workshop.slug}/`,
};

const primaryCta = workshop.registrationUrl
  ? {
      href: workshop.registrationUrl,
      label: "Register now",
      external: true,
    }
  : {
      href: workshop.fallbackUrl,
      label: workshop.fallbackLabel,
      external: false,
    };
---

<BaseLayout
  title={workshop.title}
  description={workshop.summary}
  structuredData={eventSchema}
>
  <section class="page-hero section">
    <div class="page-hero__inner reveal">
      <p class="eyebrow">{workshop.badge}</p>
      <h1>{workshop.title}</h1>
      <p>{workshop.lead}</p>
    </div>
    <aside class="page-hero__aside reveal">
      <div class="detail-card detail-card--sticky">
        <span class:list={["status-pill", `status-pill--${workshop.status}`]}>
          {workshop.statusLabel}
        </span>
        <h2>{workshop.dateLabel}</h2>
        <ul class="meta-list">
          <li><strong>Time</strong><span>{workshop.timeLabel}</span></li>
          <li><strong>Venue</strong><span>{workshop.venue}</span></li>
          <li><strong>Location</strong><span>{workshop.location}</span></li>
          <li><strong>Format</strong><span>{workshop.format}</span></li>
          <li><strong>Price</strong><span>{workshop.priceLabel}</span></li>
          <li><strong>Capacity</strong><span>{workshop.seats}</span></li>
        </ul>
        <a
          class="button"
          href={primaryCta.href}
          target={primaryCta.external ? "_blank" : undefined}
          rel={primaryCta.external ? "noreferrer" : undefined}
        >
          {primaryCta.label}
        </a>
        <p class="microcopy">
          Contact us for early bird pricing, returning student discounts, and bundle options.
        </p>
      </div>
    </aside>
  </section>

  <section class="section">
    <div class="detail-layout">
      <div class="detail-main">
        <article class="info-card reveal">
          <h2>Overview</h2>
          <p>{workshop.summary}</p>
        </article>

        <article class="info-card reveal">
          <h2>Who this is for</h2>
          <ul class="check-list">
            {workshop.audience.map((item: string) => <li>{item}</li>)}
          </ul>
        </article>

        <article class="info-card reveal">
          <h2>What you leave with</h2>
          <ul class="check-list">
            {workshop.outcomes.map((item: string) => <li>{item}</li>)}
          </ul>
        </article>
      </div>

      <div class="detail-side">
        <article class="info-card reveal">
          <h2>Session flow</h2>
          <div class="schedule-grid">
            {workshop.schedule.map((step: { label: string; detail: string }) => (
              <div class="schedule-step">
                <h3>{step.label}</h3>
                <p>{step.detail}</p>
              </div>
            ))}
          </div>
        </article>

        <article class="info-card reveal">
          <h2>Bring this workshop to your space</h2>
          <p>
            This workshop can be adapted for studios, conservatories, festivals,
            and training programs. I regularly teach as a guest internationally.
          </p>
          <a class="button button--ghost" href="/contact/">Inquire about guest teaching</a>
        </article>
      </div>
    </div>
  </section>

  {workshop.focusAreas && workshop.focusAreas.length > 0 && (
    <section class="section section--tint">
      <SectionTitle
        eyebrow="Focus Areas"
        title="What we explore."
      />
      <div class="philosophy-grid">
        {workshop.focusAreas.map((area: string) => (
          <article class="info-card reveal">
            <p>{area}</p>
          </article>
        ))}
      </div>
      {workshop.moduleDescription && (
        <div class="section__footer reveal">
          <p>{workshop.moduleDescription}</p>
        </div>
      )}
    </section>
  )}
</BaseLayout>
