---
import PastWorkshopList from "../../components/PastWorkshopList.astro";
import PhilosophyGrid from "../../components/PhilosophyGrid.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import TestimonialGrid from "../../components/TestimonialGrid.astro";
import WorkshopCard from "../../components/WorkshopCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { reader } from "../../lib/reader";

const [siteSettings, allWorkshops, allPastWorkshops, testimonialsData, faqsData] = await Promise.all([
  reader.singletons.siteSettings.read(),
  reader.collections.workshops.all(),
  reader.collections.pastWorkshops.all(),
  reader.singletons.testimonials.read(),
  reader.singletons.faqs.read(),
]);
if (!siteSettings) throw new Error("Site settings not found");
if (!testimonialsData) throw new Error("Testimonials not found");
if (!faqsData) throw new Error("FAQs not found");
const isVisible = (w: Record<string, any>) => (import.meta.env.PROD ? !w.archived : true);
const workshops = allWorkshops
  .map((w: { slug: string; entry: Record<string, any> }) => ({ ...w.entry, slug: w.slug }))
  .filter(isVisible);
const openWorkshops = workshops.filter((w: Record<string, any>) => w.status === "open");
const waitlistWorkshops = workshops.filter((w: Record<string, any>) => w.status === "waitlist");
const futureWorkshops = workshops.filter((w: Record<string, any>) => w.status === "soon");
const pastWorkshops = allPastWorkshops
  .map((w: { entry: { title: string; location: string; dates: string; archived?: boolean } }) => w.entry)
  .filter(isVisible);

const workshopModules = [
  { title: "Neutral Mask: Foundations of Presence", description: "A practical exploration of physical clarity and availability through the neutral mask. Focus areas include presence without tension, grounded movement, essential action free of excess, and responsiveness to space and impulse." },
  { title: "Mimodynamics: Forces, Qualities and Transformation", description: "A study of how dynamics such as resistance, flow, weight, texture, and acceleration shape physical behaviour. This training expands expressive range and helps performers shift between energies with intention and clarity." },
  { title: "Larval Masks: Form, Play and Exaggeration", description: "An exploration of larval masks and their amplified physical language. This work builds imagination, playfulness, and a bold approach to performance through playing from form rather than psychology." },
  { title: "Commedia dell'Arte: Instinct, Rhythm & Comic Craft", description: "A dynamic training in half-mask performance grounded in Commedia traditions. This workshop develops confidence, agility, and the capacity for quick, instinctive creative choices." },
  { title: "Bouffon: Satire, Group Dynamics and Theatrical Mischief", description: "A playful yet challenging exploration of parody, critique, and collective performance. Bouffon training encourages performers to step beyond naturalism and embrace bold, surprising theatricality." },
];
---

<BaseLayout
  title="Workshops"
  description={`Upcoming Commedia dell'Arte, Neutral Mask, and physical theatre workshops led by ${siteSettings.name}.`}
>
  <section class="page-hero section">
    <div class="page-hero__inner reveal">
      <p class="eyebrow">Workshop Calendar</p>
      <h1>Physical Expression, Masks & Creative Training</h1>
      <p>
        Each workshop explores a different dimension of physical theatre,
        movement awareness, and creative invention. Modules can be taken
        individually or combined into intensive programs for schools,
        companies, or training institutions.
      </p>
    </div>
    <aside class="page-hero__aside reveal">
      <div class="portrait-card">
        <img
          src="/hero-workshops.jpg"
          alt="Ivano leading a workshop -- ensemble in movement with arms raised"
          class="portrait-card__img"
          width="1080"
          height="720"
          loading="eager"
        />
      </div>
    </aside>
  </section>

  {openWorkshops.length > 0 && (
    <section class="section">
      <SectionTitle
        eyebrow="Registration Open"
        title="Current workshops."
      />
      <div class="card-grid">
        {openWorkshops.map((workshop: any) => <WorkshopCard workshop={workshop} />)}
      </div>
    </section>
  )}

  {waitlistWorkshops.length > 0 && (
    <section class="section section--tint">
      <SectionTitle
        eyebrow="Waitlist"
        title="Waitlist workshops."
      />
      <div class="card-grid">
        {waitlistWorkshops.map((workshop: any) => <WorkshopCard workshop={workshop} />)}
      </div>
    </section>
  )}

  {futureWorkshops.length > 0 && (
    <section class="section section--tint">
      <SectionTitle
        eyebrow="Coming Soon"
        title="Future workshops."
      />
      <div class="card-grid">
        {futureWorkshops.map((workshop: any) => <WorkshopCard workshop={workshop} />)}
      </div>
    </section>
  )}

  <section class="section">
    <SectionTitle
      eyebrow="Testimonials"
      title="What students say."
    />
    <TestimonialGrid testimonials={testimonialsData.items} expandable />
  </section>

  <section class="section section--narrow" id="faq">
    <SectionTitle
      eyebrow="FAQ"
      title="Common questions."
      align="center"
    />
    <div class="faq-list">
      {
        faqsData.items.map((item: { question: string; answer: string }) => (
          <details class="faq-item reveal">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section section--tint">
    <SectionTitle
      eyebrow="Available Workshops"
      title="Workshop modules."
    />
    <PhilosophyGrid areas={workshopModules} />
  </section>

  <section class="section">
    <SectionTitle
      eyebrow="Past Workshops"
      title="Previous workshops."
    />
    <PastWorkshopList workshops={pastWorkshops} />
  </section>
</BaseLayout>
