---
import PastWorkshopList from "../../components/PastWorkshopList.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import WorkshopCard from "../../components/WorkshopCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { reader } from "../../lib/reader";

const [siteSettings, allWorkshops, allPastWorkshops] = await Promise.all([
  reader.singletons.siteSettings.read(),
  reader.collections.workshops.all(),
  reader.collections.pastWorkshops.all(),
]);
if (!siteSettings) throw new Error("Site settings not found");
const workshops = allWorkshops.map((w) => ({ ...w.entry, slug: w.slug }));
const openWorkshops = workshops.filter((w) => w.status === "open");
const waitlistWorkshops = workshops.filter((w) => w.status === "waitlist");
const futureWorkshops = workshops.filter((w) => w.status === "soon");
const pastWorkshops = allPastWorkshops.map((w) => w.entry);
---

<BaseLayout
  title="Workshops"
  description={`Upcoming Commedia dell'Arte, Neutral Mask, and physical theatre workshops led by ${siteSettings.name}.`}
>
  <section class="page-hero section">
    <div class="page-hero__inner reveal">
      <p class="eyebrow">Workshop Calendar</p>
      <h1>Physical Expression, Masks & Creative Training</h1>
      <p>
        Each workshop explores a different dimension of physical theatre,
        movement awareness, and creative invention. Modules can be taken
        individually or combined into intensive programs for schools,
        companies, or training institutions.
      </p>
    </div>
    <aside class="page-hero__aside reveal">
      <div class="portrait-card">
        <img
          src="/hero-workshops.jpg"
          alt="Ivano leading a workshop -- ensemble in movement with arms raised"
          class="portrait-card__img"
          width="1080"
          height="720"
          loading="eager"
        />
      </div>
      <div class="detail-card">
        <h2>What to expect</h2>
        <ul class="check-list">
          <li>Small groups with direct, personal feedback</li>
          <li>Full-day intensives focused on the body and the mask</li>
          <li>A space open to all levels unless noted otherwise</li>
          <li>Scholarships available for underrepresented practitioners</li>
        </ul>
      </div>
    </aside>
  </section>

  {openWorkshops.length > 0 && (
    <section class="section">
      <SectionTitle
        eyebrow="Registration Open"
        title="Workshops accepting registration now."
        description="Secure your place in the next intensive."
      />
      <div class="card-grid">
        {openWorkshops.map((workshop) => <WorkshopCard workshop={workshop} />)}
      </div>
    </section>
  )}

  {waitlistWorkshops.length > 0 && (
    <section class="section section--tint">
      <SectionTitle
        eyebrow="Waitlist"
        title="Workshops at capacity — join the waitlist."
        description="Places open up regularly. Add your name and we will reach out as soon as a spot is available."
      />
      <div class="card-grid">
        {waitlistWorkshops.map((workshop) => <WorkshopCard workshop={workshop} />)}
      </div>
    </section>
  )}

  {futureWorkshops.length > 0 && (
    <section class="section section--tint">
      <SectionTitle
        eyebrow="Coming Soon"
        title="Future workshops on the horizon."
        description="Details and registration will open closer to the dates. Express your interest to be notified first."
      />
      <div class="card-grid">
        {futureWorkshops.map((workshop) => <WorkshopCard workshop={workshop} />)}
      </div>
    </section>
  )}

  <section class="section section--tint">
    <SectionTitle
      eyebrow="Available Workshops"
      title="What I teach."
      description="These workshops can be offered individually or combined into intensive programs. Contact me to bring any of these to your studio, school, or festival."
    />
    <div class="philosophy-grid">
      <article class="philosophy-card reveal">
        <h3>Neutral Mask: Foundations of Presence</h3>
        <p>A practical exploration of physical clarity and availability through the neutral mask. Focus areas include presence without tension, grounded movement, essential action free of excess, and responsiveness to space and impulse.</p>
      </article>
      <article class="philosophy-card reveal">
        <h3>Mimodynamics: Forces, Qualities and Transformation</h3>
        <p>A study of how dynamics such as resistance, flow, weight, texture, and acceleration shape physical behaviour. This training expands expressive range and helps performers shift between energies with intention and clarity.</p>
      </article>
      <article class="philosophy-card reveal">
        <h3>Larval Masks: Form, Play and Exaggeration</h3>
        <p>An exploration of larval masks and their amplified physical language. This work builds imagination, playfulness, and a bold approach to performance through playing from form rather than psychology.</p>
      </article>
      <article class="philosophy-card reveal">
        <h3>Commedia dell'Arte: Instinct, Rhythm & Comic Craft</h3>
        <p>A dynamic training in half-mask performance grounded in Commedia traditions. This workshop develops confidence, agility, and the capacity for quick, instinctive creative choices.</p>
      </article>
      <article class="philosophy-card reveal">
        <h3>Bouffon: Satire, Group Dynamics and Theatrical Mischief</h3>
        <p>A playful yet challenging exploration of parody, critique, and collective performance. Bouffon training encourages performers to step beyond naturalism and embrace bold, surprising theatricality.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <SectionTitle
      eyebrow="Past Workshops"
      title="Where the work has been."
    />
    <PastWorkshopList workshops={pastWorkshops} />
  </section>
</BaseLayout>
