---
import { site } from "../data/site";
---

<footer class="footer">
  <div class="footer__grid">
    <div>
      <p class="eyebrow">{site.name}</p>
      <h2>{site.role}</h2>
      <p>
        Commedia dell'Arte, Neutral Mask, and physical theatre workshops rooted
        in the Lecoq pedagogy. Based in {site.baseCity}, teaching internationally.
      </p>
    </div>

    <div>
      <h3>Explore</h3>
      <ul>
        {site.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h3>Connect</h3>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>Based in {site.baseCity}, Italy</li>
        <li>International workshops and intensives</li>
      </ul>
    </div>
  </div>

  <div class="footer__legal">
    <span>{site.name}</span>
    <span>Commedia dell'Arte, Neutral Mask, and physical theatre.</span>
  </div>
</footer>
